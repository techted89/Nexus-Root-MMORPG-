<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRunScript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Run"
            android:backgroundTint="#006600"
            android:textColor="#00FF00"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSaveScript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="#004400"
            android:textColor="#00FF00"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etScriptContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:background="#112211"
        android:textColor="#00FF00"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:hint="print(\"Hello World\")"
        android:textColorHint="#005500"/>

    <TextView
        android:id="@+id/tvScriptOutput"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#000000"
        android:textColor="#00AA00"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:scrollbars="vertical"/>

</LinearLayout>
