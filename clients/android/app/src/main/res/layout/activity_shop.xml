<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nexus Shop"
        android:textColor="#00FF00"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:fontFamily="monospace"/>

    <Button
        android:id="@+id/btnBuy1000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1000 NexusCoins"
        android:backgroundTint="#004400"
        android:textColor="#00FF00"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnBuy5000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5000 NexusCoins"
        android:backgroundTint="#004400"
        android:textColor="#00FF00"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnBuyVIP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VIP Status (Lifetime)"
        android:backgroundTint="#440044"
        android:textColor="#FF00FF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecting to Play Store..."
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:fontFamily="monospace"/>

</LinearLayout>
